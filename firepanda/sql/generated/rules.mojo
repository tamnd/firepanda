"""The DuckDB grammar, flattened into one array of nodes.

Generated by tools/gen_grammar.py from firepanda/sql/grammar/.
Do not edit. Run `python tools/gen_grammar.py` and commit the result.

Vendored grammar: 5d1f235d987d4c29.
1187 rules, 4422 nodes, 392 strings.

The table is one string rather than a list of structs on purpose. A list
literal with tens of thousands of entries is a compile time cost paid by
everyone who builds firepanda, whether or not they use SQL, and the table
is read once into a Grammar at startup. See docs/specs/sql/03-the-grammar.md
section 5.
"""


# Node kinds, in the order tools/gen_grammar.py writes them.
comptime NODE_SEQ: UInt8 = 1
comptime NODE_CHOICE: UInt8 = 2
comptime NODE_OPT: UInt8 = 3
comptime NODE_STAR: UInt8 = 4
comptime NODE_PLUS: UInt8 = 5
comptime NODE_NOT: UInt8 = 6
comptime NODE_REF: UInt8 = 7
comptime NODE_LIT: UInt8 = 8
comptime NODE_CLASS: UInt8 = 9
comptime NODE_CAPTURE: UInt8 = 10
comptime NODE_KEYWORDS: UInt8 = 11

# Set on a literal node whose text is a word, meaning it must not match the
# front of a longer identifier.
comptime FLAG_WORD: UInt8 = 1

comptime RULE_COUNT: Int = 1187
comptime NODE_COUNT: Int = 4422
comptime STRING_COUNT: Int = 392

# Rules the matcher memoizes, by index. Copied from DuckDB rather than
# chosen, see docs/specs/sql/04-the-parser.md.
comptime MEMOIZED_COUNT: Int = 22

# Rules the matcher matches itself rather than by walking the body, and
# how many rules carry each. Vendored from the rule overrides in DuckDB's
# compiled_grammar.cpp, because OperatorLiteral reads `Identifier` in the
# grammar text and a bare `+` is not an identifier.
comptime MATCHER_NONE: UInt8 = 0
comptime MATCHER_IDENTIFIER: UInt8 = 1
comptime MATCHER_RESERVED_IDENTIFIER: UInt8 = 2
comptime MATCHER_NUMBER_LITERAL: UInt8 = 3
comptime MATCHER_STRING_LITERAL: UInt8 = 4
comptime MATCHER_OPERATOR: UInt8 = 5
comptime MATCHER_COUNT: Int = 6
comptime OVERRIDDEN_COUNT: Int = 24

# The suggestion each overridden rule was built with. The identifier
# matcher reads it to decide which keyword class the position tolerates
# and whether a single quoted string is a name there, so a table name and
# a type name do not accept the same words.
comptime SUGGEST_NONE: UInt8 = 0
comptime SUGGEST_VARIABLE: UInt8 = 1
comptime SUGGEST_CATALOG_NAME: UInt8 = 2
comptime SUGGEST_SCHEMA_NAME: UInt8 = 3
comptime SUGGEST_TABLE_NAME: UInt8 = 4
comptime SUGGEST_COLUMN_NAME: UInt8 = 5
comptime SUGGEST_TYPE_NAME: UInt8 = 6
comptime SUGGEST_SCALAR_FUNCTION_NAME: UInt8 = 7
comptime SUGGEST_TABLE_FUNCTION_NAME: UInt8 = 8
comptime SUGGEST_PRAGMA_NAME: UInt8 = 9
comptime SUGGEST_SETTING_NAME: UInt8 = 10
comptime SUGGESTION_COUNT: Int = 11

# Two rules the matcher supplies itself. EndOfInput is referenced by the
# grammar and defined nowhere in it, and gets the index one past the last
# real rule. %whitespace is defined but never referenced, because it is
# applied between tokens rather than called.
comptime RULE_END_OF_INPUT: Int = 1187
comptime RULE_WHITESPACE: Int = 0

